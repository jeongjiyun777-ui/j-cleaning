# PostgreSQL (replace with your local or Neon connection details)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cleanquote_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password

# Authentication and administrator notification settings
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=정지윤
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-pwdlib-argon2-password-hash
COOKIE_SECURE=false

# Email notifications (SMTP)
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=replace-with-an-app-password
